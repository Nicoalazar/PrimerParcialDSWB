# Copiar este archivo como .env y completar
PORT=3000
NODE_ENV=development

# Local:  mongodb://127.0.0.1:27017/freshroute
# Atlas:  mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/freshroute
MONGO_URI=mongodb://127.0.0.1:27017/freshroute

# Secreto para firmar los JWT: un texto largo y aleatorio, distinto en cada entorno
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h
