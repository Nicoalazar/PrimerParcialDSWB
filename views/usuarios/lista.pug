extends ../layout

block content
  h2 Usuarios
  p
    a(href="/usuarios/nuevo") + Nuevo usuario
  table
    thead
      tr
        th Nombre
        th Email
        th Rol
        th Acciones
    tbody
      if usuarios.length === 0
        tr
          td(colspan="4") No hay usuarios cargados.
      else
        each u in usuarios
          tr
            td= u.nombre
            td= u.email
            td= u.rol
            td
              a(href=`/usuarios/${u.id}/editar`) Editar
              |
              |
              //- el admin no puede borrarse a sí mismo (el backend también lo controla)
              if u.id !== usuario.id
                form(action=`/usuarios/${u.id}/eliminar` method="POST" style="display:inline")
                  button(type="submit") Eliminar
