extends ../layout

block content
    h2 Detalle del Pedido ##{pedido.id}

    p
        strong Estado actual: 
        span= pedido.estado
    p
        strong Cliente: 
        span= cliente ? cliente.nombre : "(cliente eliminado)"
    p
        strong Chofer asignado: 
        span= chofer ? `${chofer.nombre} ${chofer.apellido}` : "(chofer eliminado)"
    p
        strong Fecha programada: 
        span= pedido.fechaHoraProgramada

    h3 Items del pedido
    if pedido.items && pedido.items.length > 0
        ul
            each item in pedido.items
                li #{item.descripcion} - Cantidad: #{item.cantidad}
    else
        p Sin items especificados.

    hr

    h3 Historial de Estados
    if pedido.historial && pedido.historial.length > 0
        ul.historial-lista
            each h in pedido.historial
                li
                    strong Estado: 
                    span= h.estado
                    |  — 
                    strong Usuario: 
                    //- si el usuario se borró, populate deja null
                    span= h.usuarioId ? h.usuarioId.nombre : "(usuario eliminado)"
                    |  —
                    strong Fecha:
                    //- hora de Argentina aunque el server (Render) corra en UTC
                    span= new Date(h.fecha).toLocaleString("es-AR", { timeZone: "America/Argentina/Buenos_Aires" })
    else
        p No hay registros en el historial.

    hr

    if proximoEstado
        form(action=`/pedidos/${pedido.id}/estado` method="POST")
            button(type="submit") Avanzar estado a "#{proximoEstado}"
    else
        p Este pedido ya se encuentra en su estado final (entregado).

    p
        a(href="/pedidos") ← Volver al listado