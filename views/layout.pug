doctype html
html(lang="es")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title= titulo || "FreshRoute B2B"
    link(rel="stylesheet" href="/css/styles.css")
  body
    header
      h1 FreshRoute B2B
      nav
        a(href="/") Inicio
        if usuario
          a(href="/clientes") Clientes
          a(href="/choferes") Choferes
          a(href="/pedidos") Pedidos
          if usuario.rol === "admin"
            a(href="/usuarios") Usuarios
      .sesion
        if usuario
          span #{usuario.nombre} (#{usuario.rol})
          form(action="/logout" method="POST")
            button(type="submit") Cerrar sesión
        else
          a(href="/login") Iniciar sesión
    main
      block content
    footer
      p Entrega Final DSWB - 2C 2026
