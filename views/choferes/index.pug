extends ../layout

block content
    .container.mt-4
        h2.mb-4= titulo

        if usuario && (usuario.rol === 'admin' || usuario.rol === 'operador')
            a.btn.btn-primary.mb-3(href="/choferes/nuevo") Nuevo Chofer

        table.table.table-striped.table-dark.text-white
            thead
                tr
                    th Nombre
                    th Apellido
                    th Vehículo
                    th Zona
                    if usuario && (usuario.rol === 'admin' || usuario.rol === 'operador')
                        th Acciones
            tbody
                each chofer in choferes
                    tr
                        td= chofer.nombre
                        td= chofer.apellido
                        td= chofer.vehiculo
                        td= chofer.zona
                        if usuario && (usuario.rol === 'admin' || usuario.rol === 'operador')
                            td
                                a.btn.btn-sm.btn-warning.me-2(href=`/choferes/${chofer._id}/editar`) Editar
                                if usuario.rol === 'admin'
                                    form.d-inline(action=`/choferes/${chofer._id}/eliminar`, method="POST" onsubmit="return confirm('¿Estás seguro de eliminar este chofer?');")
                                        button.btn.btn-sm.btn-danger(type="submit") Eliminar