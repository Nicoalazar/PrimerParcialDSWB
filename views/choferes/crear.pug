extends ../layout

block content
    .container.mt-4
        h2.mb-4= titulo

        form(action="/choferes" method="POST")
            .mb-3
                label.form-label(for="nombre") Nombre
                input.form-control(type="text" id="nombre" name="nombre", required)

            .mb-3
                label.form-label(for="apellido") Apellido
                input.form-control(type="text" id="apellido" name="apellido", required)

            .mb-3
                label.form-label(for="vehiculo") Vehículo
                input.form-control(type="text" id="vehiculo" name="vehiculo", required)

            .mb-3
                label.form-label(for="zona") Zona
                input.form-control(type="text" id="zona" name="zona", required)

            button.btn.btn-success(type="submit") Guardar Chofer
            a.btn.btn-secondary.ms-2(href="/choferes") Cancelar

            